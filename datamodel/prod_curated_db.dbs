    CAST(NULL AS VARCHAR(65535)) AS "EXTERNAL_ID",
    CAST(NULL AS VARCHAR(65535)) AS "LASTREFERENCEDDATE",
    CAST(NULL AS VARCHAR(65535)) AS "HOUSE_ADVISOR_CODE",
    CAST(NULL AS VARCHAR(65535)) AS "NAME",
    CAST(NULL AS VARCHAR(65535)) AS "SYSTEMMODSTAMP",
    CAST(NULL AS VARCHAR(65535)) AS "OWNERID",
    CAST(NULL AS VARCHAR(65535)) AS "CREATEDBYID",
    CAST(NULL AS VARCHAR(65535)) AS "ODS_ADVISORTEAMID",
    CAST(NULL AS VARCHAR(65535)) AS "CREATEDDATE",
    CAST(NULL AS VARCHAR(65535)) AS "ACCOUNTING_TEAM_CODE",
    CAST(NULL AS VARCHAR(65535)) AS "ID",
    CAST(NULL AS VARCHAR(65535)) AS "HOUSEHOLD",
    CAST(NULL AS VARCHAR(65535)) AS "LASTMODIFIEDBYID",
    CAST(NULL AS VARCHAR(65535)) AS "DEPARTMENT",
    CAST(NULL AS VARCHAR(65535)) AS "OSJ",
    CAST(NULL AS VARCHAR(65535)) AS "ACCOUNTING_TEAM_START_DATE",
    CAST(NULL AS VARCHAR(65535)) AS "BATCH_NUMBER",
    CAST(NULL AS VARCHAR(65535)) AS "FILE_DATE",
    CAST(NULL AS VARCHAR(65535)) AS "DBT_UPDATED_AT",
    CAST(NULL AS VARCHAR(65535)) AS "DBT_VALID_FROM",
    CAST(NULL AS VARCHAR(65535)) AS "DBT_VALID_TO",
    CAST(NULL AS VARCHAR(65535)) AS "DBT_SCD_ID"
FROM (VALUES (0)) AS "_DUMMY" ("_X")
WHERE 1 = 0]]></options>
		</table>
